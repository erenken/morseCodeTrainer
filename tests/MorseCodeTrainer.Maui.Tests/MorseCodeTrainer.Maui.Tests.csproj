<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- The test runner consumes the app assembly, not its packaged image resources. -->
		<DisableResizetizer>true</DisableResizetizer>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="coverlet.collector" PrivateAssets="all" />
		<ProjectReference Include="../../src/MorseCodeTrainer.Maui/MorseCodeTrainer.Maui.csproj" />
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>
</Project>
